# This repo is the whole SN6 Resources handoff: pain points, standards, the
# composites app, datasheets, printables, and the tooling that builds them.
#
# The git root is SN6 Resources/ because the scripts in tools/ resolve their
# paths as  <tools>/../03 App/... , so they only run correctly from here.
# Note that firebase deploy still runs from inside "03 App/".
#
# Track everything except build artifacts and OS junk:

.DS_Store
.venv/
node_modules/
.firebase/
__pycache__/
*.pyc

# CFD viewer: packaged builds, and the perturbed sample that
# tools/make-test-variant.mjs regenerates on demand.
07 CFD PDF Viewer/dist/
07 CFD PDF Viewer/DP_22_variant.pdf
.gstack/

# Firebase emulator log, rewritten every time tools/test_wo_rules.mjs runs.
03 App/firestore-debug.log

# Sheet images written by tools/test_drawings.mjs --shots
.drawing-shots/

# Screenshots written by tools/shoot_ui.mjs --out .ui-shots
.ui-shots/

# Transient git worktrees created for parallel subagents
.claude/worktrees/

# claude.ai/design sync: staged converter scripts + their deps, the generated
# upload bundle, and machine-local cache (the staged package, react, verdicts).
# The durable inputs under .design-sync/ (config.json, NOTES.md,
# conventions.md, stage-pkg.mjs) ARE tracked.
# bare (no slash) so a worktree's SYMLINK to them is ignored too,
# not only the real directories in the main checkout:
.ds-sync
ds-bundle
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Team website: the design system copied in from "06 Design System/" by
# "08 Website/build.mjs". Generated, one source of truth, never edited here.
08 Website/site/_ds/
